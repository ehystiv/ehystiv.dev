---
import logo from '../assets/logo.png';
import ThemeToggle from './ThemeToggle.astro';
import { translations, type Locale } from '../i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];

const homeHref = locale === 'it' ? '/' : '/en';
const personalHref = locale === 'it' ? '/personal' : '/en/personal';

// Language switcher: swap the locale prefix while staying on the current page
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
let langSwitchHref: string;
if (locale === 'it') {
	langSwitchHref = currentPath === '/' ? '/en' : `/en${currentPath}`;
} else {
	const unprefixed = currentPath.replace(/^\/en/, '');
	langSwitchHref = unprefixed === '' ? '/' : unprefixed;
}

const navLinks = [
	{ href: `${homeHref}#projects`, label: t.nav.projects },
	{ href: `${homeHref}#inspirations`, label: t.nav.inspirations },
	{ href: `${homeHref}#about`, label: t.nav.about },
	{ href: personalHref, label: t.nav.personal }
];
---

<header id="site-header" class="relative border-b border-[var(--color-border)]">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-2">
		<!-- Logo / Name -->
		<a href={homeHref} class="group flex items-center gap-3 no-underline">
			<img
				src={logo.src}
				alt="ehystiv.dev logo"
				class="nav-logo h-20 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
			/>
			<div class="hidden flex-col leading-none sm:flex">
				<span class="font-display text-lg font-black tracking-widest">
					EHYSTIV<span class="neon-text flicker">.DEV</span>
				</span>
				<span class="mt-1 font-mono text-[10px] tracking-[0.3em] text-[var(--color-muted)] uppercase">
					Night City // Netrunner
				</span>
			</div>
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden items-center gap-6 md:flex">
			{navLinks.map((link) => (
				<a href={link.href} class="nav-link font-mono text-sm font-bold tracking-wider uppercase">
					{link.label}
				</a>
			))}
			<a
				href="https://github.com/ehystiv"
				target="_blank"
				rel="noopener noreferrer"
				class="btn-cyber inline-block text-xs no-underline"
			>
				{t.nav.github}
			</a>

			<!-- Language Switcher -->
			<a href={langSwitchHref} class="nav-link font-mono text-sm font-bold uppercase">
				{locale === 'it' ? 'EN' : 'IT'}
			</a>

			<!-- Theme Toggle -->
			<ThemeToggle />
		</nav>

		<!-- Mobile Menu Button -->
		<div class="flex items-center gap-4 md:hidden">
			<ThemeToggle />
			<button
				id="mobile-menu-button"
				class="btn-cyber px-3 py-2 text-sm"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				MENU
			</button>
		</div>
	</div>

	<!-- Mobile Menu Overlay -->
	<div
		id="mobile-menu"
		class="hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:hidden"
	>
		<nav class="flex flex-col gap-6 text-center">
			{navLinks.map((link) => (
				<a href={link.href} class="nav-link font-mono text-lg font-bold tracking-wider uppercase">
					{link.label}
				</a>
			))}
			<a
				href="https://github.com/ehystiv"
				target="_blank"
				rel="noopener noreferrer"
				class="btn-cyber mx-auto inline-block no-underline"
			>
				{t.nav.github}
			</a>

			<div class="flex justify-center gap-4 border-t border-[var(--color-border)] pt-4">
				<a href={langSwitchHref} class="nav-link font-mono text-lg font-bold uppercase">
					{locale === 'it' ? 'Switch to EN' : 'Passa a IT'}
				</a>
			</div>
		</nav>
	</div>

	<!-- Neon edge under the header -->
	<div class="neon-rule absolute right-0 -bottom-px left-0"></div>
</header>

<!-- Ticker / Time bar -->
<div class="ticker-bar sticky top-0 z-50 flex items-center justify-between bg-[var(--color-bar-bg)] px-6 py-1 text-[var(--color-bar-fg)]">
	<div class="flex items-center gap-3">
		<span class="status-dot" aria-hidden="true"></span>
		<div class="ticker-wrapper">
			<div id="header-ticker" class="ticker-inner">
				<span class="ticker-item">FULL STACK WEB DEVELOPER</span>
				<span class="ticker-item">EHYSTIV.DEV // ONLINE</span>
				<span class="ticker-item">FULL STACK WEB DEVELOPER</span>
			</div>
		</div>
	</div>
	<span class="flex items-center gap-2 font-mono text-xs font-bold tabular-nums">
		<span class="hidden opacity-70 sm:inline">NC.TIME</span>
		<span id="header-clock" data-locale={locale}></span>
	</span>
</div>

<style>
	/* The logo PNG is black on white: blend the white away (day) or invert and screen it (night) */
	.nav-logo {
		mix-blend-mode: multiply;
	}

	:global(.dark) .nav-logo {
		filter: invert(1);
		mix-blend-mode: screen;
	}

	.nav-link {
		transition:
			color 0.2s ease,
			text-shadow 0.2s ease;
	}

	.nav-link:hover {
		color: var(--color-accent);
		text-shadow: var(--glow-accent);
	}

	.ticker-bar {
		clip-path: polygon(0 0, 100% 0, 100% 100%, 12px 100%, 0 calc(100% - 6px));
	}

	.status-dot {
		width: 8px;
		height: 8px;
		background-color: var(--color-accent-hot);
		box-shadow: 0 0 6px var(--color-accent-hot);
		animation: pulse 1.6s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.3;
		}
	}

	.ticker-wrapper {
		overflow: hidden;
		height: 1rem;
	}

	.ticker-active {
		animation: ticker-flip 10s ease-in-out infinite;
	}

	.ticker-item {
		display: block;
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		line-height: 1rem;
		letter-spacing: 0.15em;
		font-weight: 700;
	}

	@keyframes ticker-flip {
		0%,
		45% {
			transform: translateY(0);
		}
		50%,
		95% {
			transform: translateY(-33.333%);
		}
		100% {
			transform: translateY(-66.666%);
		}
	}
</style>

<script>
	// Sticky ticker: start flipping when the header scrolls out of view
	const header = document.getElementById('site-header');
	const ticker = document.getElementById('header-ticker');

	if (header && ticker) {
		const observer = new IntersectionObserver(([entry]) => {
			ticker.classList.toggle('ticker-active', !entry.isIntersecting);
		});
		observer.observe(header);
	}

	// Clock
	const clock = document.getElementById('header-clock');

	if (clock) {
		const timeLocale = clock.dataset.locale === 'en' ? 'en-US' : 'it-IT';
		const updateTime = () => {
			clock.textContent = new Date().toLocaleTimeString(timeLocale, {
				hour: '2-digit',
				minute: '2-digit',
				second: '2-digit'
			});
		};
		updateTime();
		setInterval(updateTime, 1000);
	}

	// Mobile menu
	const menuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');

	if (menuButton && mobileMenu) {
		const setMenuOpen = (open: boolean) => {
			mobileMenu.classList.toggle('hidden', !open);
			menuButton.textContent = open ? '✕' : 'MENU';
			menuButton.setAttribute('aria-expanded', String(open));
		};

		menuButton.addEventListener('click', () => {
			setMenuOpen(mobileMenu.classList.contains('hidden'));
		});

		mobileMenu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});
	}
</script>
