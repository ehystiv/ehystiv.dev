---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { FORCED_THEME } from '../theme';
import { translations, type Locale } from '../i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];

const homeHref = locale === 'it' ? '/' : '/en';
const personalHref = locale === 'it' ? '/personal' : '/en/personal';

// Language switcher: swap the locale prefix while staying on the current page
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
let langSwitchHref: string;
if (locale === 'it') {
	langSwitchHref = currentPath === '/' ? '/en' : `/en${currentPath}`;
} else {
	const unprefixed = currentPath.replace(/^\/en/, '');
	langSwitchHref = unprefixed === '' ? '/' : unprefixed;
}

const navLinks = [
	{ href: `${homeHref}#projects`, label: t.nav.projects },
	{ href: `${homeHref}#inspirations`, label: t.nav.inspirations },
	{ href: `${homeHref}#about`, label: t.nav.about },
	{ href: personalHref, label: t.nav.personal }
];
---

<header id="site-header" class="relative border-b border-[var(--color-border)]">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
		<!-- Logo / Name -->
		<a href={homeHref} class="group flex items-center gap-3 no-underline">
			<Logo class="h-14 w-14 transition-transform duration-200 group-hover:scale-105" />
			<div class="hidden flex-col leading-none sm:flex">
				<span class="font-display text-lg font-black tracking-widest">
					EHYSTIV<span class="neon-text flicker">.DEV</span>
				</span>
				<span class="mt-1 font-mono text-[10px] tracking-[0.3em] text-[var(--color-muted)] uppercase">
					Night City // Netrunner
				</span>
			</div>
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden items-center gap-6 md:flex">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class="nav-link glitch-hover font-mono text-sm font-bold tracking-wider uppercase"
				>
					{link.label}
				</a>
			))}
			<a
				href="https://github.com/ehystiv"
				target="_blank"
				rel="noopener noreferrer"
				class="btn-cyber inline-block text-xs no-underline"
			>
				{t.nav.github}
			</a>

			<!-- Language Switcher -->
			<a href={langSwitchHref} class="nav-link glitch-hover font-mono text-sm font-bold uppercase">
				{locale === 'it' ? 'EN' : 'IT'}
			</a>

			<!-- Theme Toggle -->
			{!FORCED_THEME && <ThemeToggle />}
		</nav>

		<!-- Mobile Menu Button -->
		<div class="flex items-center gap-4 md:hidden">
			{!FORCED_THEME && <ThemeToggle />}
			<button
				id="mobile-menu-button"
				class="btn-cyber px-3 py-2 text-sm"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				MENU
			</button>
		</div>
	</div>

	<!-- Mobile Menu Overlay: full-screen, opens like a CRT turning on, items glitch in one by one -->
	<div
		id="mobile-menu"
		class="mobile-menu fixed inset-0 z-[60] md:hidden"
		role="dialog"
		aria-modal="true"
		aria-label="Menu"
		data-state="closed"
		hidden
	>
		<div class="menu-panel flex h-full flex-col bg-[var(--color-bg)]">
			<div class="menu-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
			<div
				class="menu-sign pointer-events-none absolute right-4 bottom-24 font-bold"
				aria-hidden="true"
			>
				メニュー
			</div>

			<!-- Top bar -->
			<div class="relative flex items-center justify-between border-b border-[var(--color-border)] px-6 py-5">
				<span class="menu-meta font-mono text-xs tracking-[0.3em] text-[var(--color-accent-alt)] uppercase">
					// NAV.SYS <span class="text-[var(--color-accent-hot)]">ACCESS GRANTED</span>
				</span>
				<button
					id="mobile-menu-close"
					type="button"
					class="btn-cyber px-3 py-2 text-sm"
					aria-label="Close menu"
				>
					✕
				</button>
			</div>

			<!-- Links -->
			<nav class="relative flex-1 overflow-y-auto px-6 py-8">
				<ul class="flex flex-col">
					{navLinks.map((link, i) => (
						<li class="menu-item border-b border-[var(--color-border)]" style={`--i: ${i}`}>
							<a href={link.href} class="group flex items-center gap-4 py-5 no-underline">
								<span class="font-mono text-xs text-[var(--color-accent-hot)]">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span
									class="menu-label glitch-hover font-display text-3xl font-black uppercase transition-colors group-hover:text-[var(--color-accent)]"
									data-menu-scramble
								>
									{link.label}
								</span>
								<span class="ml-auto font-mono text-[var(--color-accent-alt)] opacity-60 transition-opacity group-hover:opacity-100">
									→
								</span>
							</a>
						</li>
					))}
				</ul>

				<div
					class="menu-item mt-10 flex flex-wrap items-center gap-6"
					style={`--i: ${navLinks.length}`}
				>
					<a
						href="https://github.com/ehystiv"
						target="_blank"
						rel="noopener noreferrer"
						class="btn-cyber btn-cyber-filled no-underline"
					>
						{t.nav.github}
					</a>
					<a
						href={langSwitchHref}
						class="nav-link glitch-hover font-mono text-sm font-bold tracking-wider uppercase"
					>
						{locale === 'it' ? 'Switch to EN' : 'Passa a IT'}
					</a>
				</div>
			</nav>

			<!-- HUD footer -->
			<div class="menu-meta relative flex justify-between border-t border-[var(--color-border)] px-6 py-3 font-mono text-[10px] tracking-widest text-[var(--color-muted)] uppercase">
				<span>EHYSTIV.DEV // v2.077</span>
				<span>
					LINK <span class="text-[var(--color-accent)]">SECURE</span>
				</span>
			</div>
		</div>
	</div>

	<!-- Neon edge under the header -->
	<div class="neon-rule absolute right-0 -bottom-px left-0"></div>
</header>

<!-- Ticker / Time bar -->
<div class="ticker-bar sticky top-0 z-50 flex items-center justify-between bg-[var(--color-bar-bg)] px-6 py-1 text-[var(--color-bar-fg)]">
	<div class="flex items-center gap-3">
		<span class="status-dot" aria-hidden="true"></span>
		<div class="ticker-wrapper">
			<div id="header-ticker" class="ticker-inner">
				<span class="ticker-item">FULL STACK WEB DEVELOPER</span>
				<span class="ticker-item">EHYSTIV.DEV // ONLINE</span>
				<span class="ticker-item">FULL STACK WEB DEVELOPER</span>
			</div>
		</div>
	</div>
	<span class="flex items-center gap-2 font-mono text-xs font-bold tabular-nums">
		<span class="hidden opacity-70 sm:inline">NC.TIME</span>
		<span id="header-clock" data-locale={locale}></span>
	</span>
</div>

<style>
	.nav-link {
		transition:
			color 0.2s ease,
			text-shadow 0.2s ease;
	}

	.nav-link:hover {
		color: var(--color-accent);
		text-shadow: var(--glow-accent);
	}

	.ticker-bar {
		clip-path: polygon(0 0, 100% 0, 100% 100%, 12px 100%, 0 calc(100% - 6px));
	}

	.status-dot {
		width: 8px;
		height: 8px;
		background-color: var(--color-accent-hot);
		box-shadow: 0 0 6px var(--color-accent-hot);
		animation: pulse 1.6s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.3;
		}
	}

	.ticker-wrapper {
		overflow: hidden;
		height: 1rem;
	}

	.ticker-active {
		animation: ticker-flip 10s ease-in-out infinite;
	}

	.ticker-item {
		display: block;
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		line-height: 1rem;
		letter-spacing: 0.15em;
		font-weight: 700;
	}

	@keyframes ticker-flip {
		0%,
		45% {
			transform: translateY(0);
		}
		50%,
		95% {
			transform: translateY(-33.333%);
		}
		100% {
			transform: translateY(-66.666%);
		}
	}
	/* ---------- Mobile menu ---------- */
	.mobile-menu .menu-panel {
		position: relative;
		background-image:
			radial-gradient(ellipse 70% 40% at 100% 0%, rgb(255 42 109 / 0.18), transparent 70%),
			radial-gradient(ellipse 60% 40% at 0% 100%, rgb(0 240 255 / 0.12), transparent 70%);
	}

	.menu-grid {
		background-image:
			linear-gradient(var(--color-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
		background-size: 40px 40px;
	}

	.menu-sign {
		writing-mode: vertical-rl;
		font-size: 3.5rem;
		letter-spacing: 0.1em;
		color: transparent;
		-webkit-text-stroke: 1px var(--color-accent-hot);
		filter: drop-shadow(0 0 6px var(--color-accent-hot));
		opacity: 0.35;
	}

	/* Open: a neon line appears in the middle, stretches horizontally, then the screen opens vertically */
	.mobile-menu[data-state='open'] .menu-panel {
		animation: crt-on 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.mobile-menu[data-state='closing'] .menu-panel {
		animation: crt-off 0.4s cubic-bezier(0.6, 0, 0.8, 0.2) both;
	}

	@keyframes crt-on {
		0% {
			clip-path: inset(49.6% 50% 49.6% 50%);
			filter: brightness(1.3);
			background-color: #c8fdff;
		}
		35% {
			clip-path: inset(49.6% 0 49.6% 0);
			filter: brightness(1.3);
			background-color: #c8fdff;
		}
		55% {
			filter: brightness(1.8);
			background-color: var(--color-bg);
		}
		100% {
			clip-path: inset(0 0 0 0);
			filter: none;
		}
	}

	@keyframes crt-off {
		0% {
			clip-path: inset(0 0 0 0);
			filter: none;
		}
		55% {
			clip-path: inset(49.6% 0 49.6% 0);
			filter: brightness(1.3);
			background-color: #c8fdff;
		}
		100% {
			clip-path: inset(49.6% 50% 49.6% 50%);
			filter: brightness(1.3);
			background-color: #c8fdff;
		}
	}

	/* Items: staggered slice-in with RGB split, after the screen has opened */
	.mobile-menu[data-state='open'] .menu-item {
		animation: menu-item-in 0.5s steps(6, end) both;
		animation-delay: calc(0.45s + var(--i) * 0.09s);
	}

	.mobile-menu[data-state='open'] .menu-meta {
		animation: menu-meta-in 0.4s steps(4, end) 0.4s both;
	}

	.mobile-menu[data-state='closing'] .menu-item,
	.mobile-menu[data-state='closing'] .menu-meta {
		opacity: 0;
		transition: opacity 0.1s steps(2);
	}

	@keyframes menu-item-in {
		0% {
			opacity: 0;
			transform: translateX(-30px) skewX(-12deg);
			clip-path: inset(0 100% 0 0);
		}
		30% {
			opacity: 1;
			transform: translateX(8px) skewX(8deg);
			clip-path: inset(0 40% 0 0);
			text-shadow:
				-4px 0 var(--color-accent-alt),
				4px 0 var(--color-accent-hot);
		}
		55% {
			transform: translateX(-3px);
			clip-path: inset(30% 0 20% 0);
			text-shadow:
				3px 0 var(--color-accent-alt),
				-3px 0 var(--color-accent-hot);
		}
		75% {
			transform: translateX(2px);
			clip-path: inset(0 0 0 0);
		}
		100% {
			opacity: 1;
			transform: none;
			clip-path: none;
			text-shadow: none;
		}
	}

	@keyframes menu-meta-in {
		0%,
		50% {
			opacity: 0;
		}
		25%,
		75%,
		100% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu .menu-panel,
		.mobile-menu .menu-item,
		.mobile-menu .menu-meta {
			animation: none !important;
		}
	}
</style>

<script>
	import { scramble } from '../scripts/glitch-text';

	// Sticky ticker: start flipping when the header scrolls out of view
	const header = document.getElementById('site-header');
	const ticker = document.getElementById('header-ticker');

	if (header && ticker) {
		const observer = new IntersectionObserver(([entry]) => {
			ticker.classList.toggle('ticker-active', !entry.isIntersecting);
		});
		observer.observe(header);
	}

	// Clock
	const clock = document.getElementById('header-clock');

	if (clock) {
		const timeLocale = clock.dataset.locale === 'en' ? 'en-US' : 'it-IT';
		const updateTime = () => {
			clock.textContent = new Date().toLocaleTimeString(timeLocale, {
				hour: '2-digit',
				minute: '2-digit',
				second: '2-digit'
			});
		};
		updateTime();
		setInterval(updateTime, 1000);
	}

	// Mobile menu: full-screen overlay with CRT open/close and glitching items
	const menuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');
	const closeButton = document.getElementById('mobile-menu-close');

	if (menuButton && mobileMenu) {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const ITEM_DELAY = 450;
		const ITEM_STAGGER = 90;
		let closeTimer: number | undefined;

		const openMenu = () => {
			window.clearTimeout(closeTimer);
			mobileMenu.hidden = false;
			mobileMenu.dataset.state = 'open';
			menuButton.setAttribute('aria-expanded', 'true');
			document.documentElement.style.overflow = 'hidden';
			closeButton?.focus({ preventScroll: true });

			if (reducedMotion.matches) return;
			// Decrypt each label as its row glitches in
			mobileMenu.querySelectorAll<HTMLElement>('[data-menu-scramble]').forEach((label, i) => {
				label.textContent = label.dataset.scrambleText ?? label.textContent;
				window.setTimeout(() => scramble(label, 450), ITEM_DELAY + i * ITEM_STAGGER);
			});
		};

		const closeMenu = (restoreFocus = true) => {
			if (mobileMenu.dataset.state !== 'open') return;
			menuButton.setAttribute('aria-expanded', 'false');
			document.documentElement.style.overflow = '';
			const finish = () => {
				mobileMenu.hidden = true;
				mobileMenu.dataset.state = 'closed';
			};
			if (reducedMotion.matches) {
				finish();
			} else {
				mobileMenu.dataset.state = 'closing';
				closeTimer = window.setTimeout(finish, 400);
			}
			if (restoreFocus) menuButton.focus({ preventScroll: true });
		};

		menuButton.addEventListener('click', openMenu);
		closeButton?.addEventListener('click', () => closeMenu());

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeMenu();
		});

		mobileMenu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => closeMenu(false));
		});

		// Leaving the mobile breakpoint with the menu open: close it instantly
		window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
			if (!event.matches) return;
			closeMenu(false);
			window.clearTimeout(closeTimer);
			mobileMenu.hidden = true;
			mobileMenu.dataset.state = 'closed';
		});
	}
</script>
