---
// The icon and title reflect the NEXT mode reached on click (cycle: light → dark → system)
---

<button
	type="button"
	class="theme-toggle btn-brutal !m-0 !flex h-10 w-10 !items-center !justify-center !p-0 transition-all duration-300"
	aria-label="Toggle Theme"
>
	<!-- Monitor Icon (shown when theme = dark, next: system) -->
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
		stroke-width="2"
		stroke="currentColor"
		class="icon-monitor h-5 w-5"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"
		></path>
	</svg>
	<!-- Sun Icon (shown when theme = system, next: light) -->
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
		stroke-width="2"
		stroke="currentColor"
		class="icon-sun h-5 w-5"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
		></path>
	</svg>
	<!-- Moon Icon (shown when theme = light, next: dark) -->
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
		stroke-width="2"
		stroke="currentColor"
		class="icon-moon h-5 w-5"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
		></path>
	</svg>
</button>

<style>
	.theme-toggle svg {
		display: none;
	}

	:global(html[data-theme='light']) .theme-toggle .icon-moon {
		display: block;
	}

	:global(html[data-theme='dark']) .theme-toggle .icon-monitor {
		display: block;
	}

	:global(html[data-theme='system']) .theme-toggle .icon-sun {
		display: block;
	}
</style>

<script>
	type Theme = 'light' | 'dark' | 'system';

	const cycle: Record<Theme, Theme> = {
		light: 'dark',
		dark: 'system',
		system: 'light'
	};

	const titles: Record<Theme, string> = {
		light: 'Switch to Dark Mode',
		dark: 'Switch to System Mode',
		system: 'Switch to Light Mode'
	};

	const root = document.documentElement;
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

	const getTheme = (): Theme => {
		const current = root.dataset.theme;
		return current === 'light' || current === 'dark' || current === 'system' ? current : 'system';
	};

	const updateTitles = () => {
		const title = titles[getTheme()];
		document.querySelectorAll('.theme-toggle').forEach((btn) => {
			btn.setAttribute('title', title);
		});
	};

	const applyTheme = (theme: Theme) => {
		root.dataset.theme = theme;
		root.classList.toggle('dark', theme === 'dark' || (theme === 'system' && systemDark.matches));
		localStorage.setItem('theme', theme);
		updateTitles();
	};

	systemDark.addEventListener('change', () => {
		if (getTheme() === 'system') {
			root.classList.toggle('dark', systemDark.matches);
		}
	});

	document.querySelectorAll('.theme-toggle').forEach((btn) => {
		btn.addEventListener('click', () => applyTheme(cycle[getTheme()]));
	});

	updateTitles();
</script>
