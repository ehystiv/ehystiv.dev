---
import type { ImageMetadata } from 'astro';
import { photoCategories, type Photo } from '../data/photos';
import BaseLayout from '../layouts/BaseLayout.astro';
import { translations, type Locale } from '../i18n/translations';

const locale = (Astro.currentLocale ?? 'it') as Locale;
const t = translations[locale];

const blogEnabled = import.meta.env.PUBLIC_BLOG_ENABLED === 'true';

// Resolve entries from src/data/photos.ts against the files in src/assets/photos/{category}/
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/photos/**/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true }
);

const resolvePhoto = (photo: Photo) => {
	const file = photoFiles[`../assets/photos/${photo.src}`];
	if (!file) {
		console.warn(`[personal] Photo file not found in src/assets/photos/: ${photo.src}`);
		return null;
	}
	const meta = [photo.shoot_on, photo.location, photo.date].filter(Boolean).join(' · ');
	return { ...photo, image: file.default, meta };
};

const resolvedCategories = photoCategories
	.map((category) => ({
		...category,
		photos: category.photos
			.map(resolvePhoto)
			.filter((photo): photo is NonNullable<typeof photo> => photo !== null)
	}))
	.filter((category) => category.photos.length > 0);

const hasPhotos = resolvedCategories.length > 0;
---

<BaseLayout locale={locale} title={t.personal.meta_title} description={t.personal.meta_description}>
	<!-- Page header -->
	<section class="relative overflow-hidden border-b border-[var(--color-border)]">
		<div class="page-grid absolute inset-0" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-7xl px-6 py-20">
			<p class="hud-label mb-2" data-scramble>
				{t.personal.pretitle}
			</p>
			<h1 class="text-4xl font-black md:text-6xl">
				<span class="glitch neon-text" data-text={t.personal.title}>
					{t.personal.title}
				</span>
			</h1>
			<p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
				{t.personal.description}
			</p>
		</div>
	</section>

	<!-- Photo portfolio -->
	<section id="photos" class="scroll-mt-4 border-b border-[var(--color-border)]">
		<div class="mx-auto max-w-7xl px-6 py-20">
			<div class="mb-12 flex items-end justify-between">
				<div>
					<p class="hud-label mb-2" data-scramble>
						{t.personal.photos.pretitle}
					</p>
					<h2 class="text-4xl font-black md:text-5xl" data-scramble>
						{t.personal.photos.title}
					</h2>
				</div>
				<div class="neon-rule mb-3 ml-8 hidden flex-1 md:block"></div>
			</div>

			{hasPhotos ? (
				<div class="space-y-12">
					{resolvedCategories.map((category) => (
						<div id={`photos-${category.id}`} class="scroll-mt-4">
							<!-- Category header -->
							<div class="mb-6 flex items-center gap-4">
								<h3 class="neon-text font-mono text-lg font-bold tracking-wider uppercase">
									{category.label[locale]}
								</h3>
								<span class="tag text-[10px]">{category.photos.length}</span>
								<div class="neon-rule flex-1"></div>
							</div>

							<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
								{category.photos.map((photo) => (
									<button
										type="button"
										data-photo
										data-full={photo.image.src}
										data-caption={photo.alt[locale]}
										data-meta={photo.meta}
										class="group cyber-panel hover-neon block w-full cursor-pointer p-0 text-left"
										aria-label={photo.alt[locale]}
									>
										<img
											src={photo.image.src}
											alt={photo.alt[locale]}
											loading="lazy"
											class="aspect-square w-full object-cover transition-[filter] duration-300 group-hover:saturate-125"
										/>
										{photo.meta && (
											<div class="flex items-center justify-between border-t border-[var(--color-border)] px-3 py-2 text-[var(--color-muted)] transition-colors group-hover:text-[var(--color-accent-alt)]">
												<span class="font-mono text-xs font-bold tracking-wider uppercase">
													{photo.meta}
												</span>
												<span class="font-mono text-xs opacity-0 transition-opacity group-hover:opacity-100">
													↗
												</span>
											</div>
										)}
									</button>
								))}
							</div>
						</div>
					))}
				</div>
			) : (
				<div class="cyber-panel p-12 text-center">
					<p class="font-mono text-xl font-bold uppercase">{t.personal.photos.empty_title}</p>
					<p class="mx-auto mt-2 max-w-md text-[var(--color-muted)]">
						{t.personal.photos.empty_text}
					</p>
				</div>
			)}
		</div>
	</section>

	<!-- Blog (hidden until PUBLIC_BLOG_ENABLED=true) -->
	{blogEnabled && (
		<section id="blog" class="scroll-mt-4 border-b border-[var(--color-border)]">
			<div class="mx-auto max-w-7xl px-6 py-20">
				<div class="mb-12 flex items-end justify-between">
					<div>
						<p class="hud-label mb-2" data-scramble>
							{t.personal.blog.pretitle}
						</p>
						<h2 class="text-4xl font-black md:text-5xl" data-scramble>
							{t.personal.blog.title}
						</h2>
					</div>
					<div class="neon-rule mb-3 ml-8 hidden flex-1 md:block" />
				</div>

				<div class="cyber-panel p-12 text-center">
					<p class="font-mono text-xl font-bold uppercase">{t.personal.blog.empty_title}</p>
					<p class="mx-auto mt-2 max-w-md text-[var(--color-muted)]">
						{t.personal.blog.empty_text}
					</p>
				</div>
			</div>
		</section>
	)}

	<!-- Photo lightbox -->
	{hasPhotos && (
		<dialog
			id="photo-lightbox"
			class="lightbox fixed inset-0 m-auto max-h-[90vh] w-full max-w-4xl border border-[var(--color-accent-alt)] bg-[var(--color-surface)] p-0 text-[var(--color-fg)] backdrop:bg-black/80 backdrop:backdrop-blur-sm"
		>
			<figure class="m-0">
				<img
					id="lightbox-img"
					src=""
					alt=""
					class="max-h-[75vh] w-full border-b border-[var(--color-border)] bg-black object-contain"
				/>
				<figcaption class="flex items-center justify-between gap-4 px-4 py-3">
					<span id="lightbox-caption" class="neon-text font-mono text-sm font-bold uppercase" />
					<span id="lightbox-meta" class="font-mono text-xs text-[var(--color-muted)]" />
				</figcaption>
			</figure>
			<button
				id="lightbox-close"
				type="button"
				class="btn-cyber btn-cyber-filled absolute top-3 right-3 px-3 py-1 text-sm"
				aria-label="Close"
			>
				✕
			</button>
		</dialog>
	)}
</BaseLayout>

<style>
	.page-grid {
		background-image:
			linear-gradient(var(--color-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: linear-gradient(to bottom, black 20%, transparent 100%);
	}

	.lightbox {
		box-shadow: 0 0 32px rgb(0 240 255 / 0.35);
	}
</style>

<script>
	// Photo lightbox: fill the shared <dialog> from the clicked card and open it modally
	const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null;

	if (dialog) {
		const image = dialog.querySelector<HTMLImageElement>('#lightbox-img');
		const caption = dialog.querySelector<HTMLElement>('#lightbox-caption');
		const meta = dialog.querySelector<HTMLElement>('#lightbox-meta');
		const closeButton = dialog.querySelector<HTMLButtonElement>('#lightbox-close');

		document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach((button) => {
			button.addEventListener('click', () => {
				if (!image) return;
				image.src = button.dataset.full ?? '';
				image.alt = button.dataset.caption ?? '';
				if (caption) caption.textContent = button.dataset.caption ?? '';
				if (meta) {
					meta.textContent = button.dataset.meta ?? '';
					meta.classList.toggle('hidden', !button.dataset.meta);
				}
				dialog.showModal();
			});
		});

		closeButton?.addEventListener('click', () => dialog.close());
		// Click on the backdrop (the dialog element itself) closes the lightbox
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>
