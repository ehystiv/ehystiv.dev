---
import { languageColors, type Project } from '../data/projects';
import { translations, type Locale } from '../i18n/translations';

interface Props {
	project: Project;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = translations[locale];

const langColor = languageColors[project.language] || '#666666';
---

<article class="group cyber-panel hover-neon p-0">
	<!-- Header -->
	<div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-3">
		<h3 class="glitch-hover font-display text-sm font-bold tracking-wider uppercase transition-colors group-hover:text-[var(--color-accent)]">
			{project.name}
		</h3>
		<div class="flex items-center gap-2 text-[var(--color-muted)]">
			<span class="h-2.5 w-2.5" style={`background-color: ${langColor}`} aria-hidden="true"></span>
			<span class="font-mono text-xs">{project.language}</span>
		</div>
	</div>

	<!-- Content -->
	<div class="p-5">
		<p class="mb-4 text-sm leading-relaxed text-[var(--color-muted)]">
			{project.longDescription[locale]}
		</p>

		<!-- Topics -->
		<div class="mb-5 flex flex-wrap gap-2">
			{project.topics.map((topic) => (
				<span class="tag">{topic}</span>
			))}
		</div>

		<!-- Actions -->
		<div class="flex items-center gap-3">
			<a
				href={project.githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn-cyber flex-1 text-center text-xs no-underline"
			>
				<span class="inline-flex items-center gap-2">
					<svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
					</svg>
					GitHub
					<span class="sr-only">
						{project.name} {t.a11y.new_tab}
					</span>
				</span>
			</a>
			{project.homepage && (
				<a
					href={project.homepage}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-cyber btn-cyber-filled flex-1 text-center text-xs no-underline"
				>
					Live Demo <span aria-hidden="true">→</span>
					<span class="sr-only">
						{project.name} {t.a11y.new_tab}
					</span>
				</a>
			)}
		</div>
	</div>

	<!-- Featured badge -->
	{project.featured && (
		<div
			class="absolute top-0 left-0 h-full w-0.5 bg-[var(--color-accent)] shadow-[0_0_8px_var(--color-accent)]"
			aria-hidden="true"
		/>
	)}
</article>
