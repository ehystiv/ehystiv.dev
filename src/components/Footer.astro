---
import { translations, type Locale } from '../i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];

const homeHref = locale === 'it' ? '/' : '/en';
const personalHref = locale === 'it' ? '/personal' : '/en/personal';

const currentYear = new Date().getFullYear();

const socials = [
	{
		name: 'GitHub',
		url: 'https://github.com/ehystiv',
		icon: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z'
	},
	{
		name: 'LinkedIn',
		url: 'https://linkedin.com/in/stefanobichicchi',
		icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'
	}
];
---

<footer class="relative mt-auto border-t border-[var(--color-border)]">
	<div class="neon-rule absolute -top-px right-0 left-0"></div>
	<!-- Main footer content -->
	<div class="mx-auto max-w-7xl px-6 py-12">
		<div class="grid gap-8 md:grid-cols-3">
			<!-- Brand -->
			<div>
				<h3 class="mb-4 text-xl font-black tracking-widest">
					EHYSTIV<span class="neon-text">.DEV</span>
				</h3>
				<p class="text-sm leading-relaxed text-[var(--color-muted)]">{t.footer.description}</p>
			</div>

			<!-- Quick Links -->
			<div>
				<h4 class="hud-label mb-4 font-bold" data-scramble>
					{t.footer.quick_links}
				</h4>
				<ul class="space-y-2">
					<li>
						<a
							href={`${homeHref}#projects`}
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							<span aria-hidden="true">→</span> {t.nav.projects}
						</a>
					</li>
					<li>
						<a
							href={`${homeHref}#about`}
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							<span aria-hidden="true">→</span> {t.nav.about}
						</a>
					</li>
					<li>
						<a
							href={personalHref}
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							<span aria-hidden="true">→</span> {t.nav.personal}
						</a>
					</li>
					<li>
						<a
							href="mailto:stefano@bichicchi.it"
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							<span aria-hidden="true">→</span> {t.about.cta_contact}
						</a>
					</li>
				</ul>
			</div>

			<!-- Social -->
			<div>
				<h4 class="hud-label mb-4 font-bold" data-scramble>
					{t.footer.social}
				</h4>
				<div class="flex gap-3">
					{socials.map((social) => (
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							class="btn-cyber flex h-12 w-12 items-center justify-center !p-0 font-mono text-xs font-bold uppercase no-underline"
							title={social.name}
						>
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path d={social.icon}></path>
							</svg>
							<span class="sr-only">
								{social.name} {t.a11y.new_tab}
							</span>
						</a>
					))}
				</div>
			</div>
		</div>
	</div>

	<!-- Copyright bar -->
	<div class="overflow-hidden bg-[var(--color-bar-bg)] py-2 text-[var(--color-bar-fg)]">
		<!-- Read once by assistive tech; the scrolling copies below are decorative -->
		<p class="sr-only">
			© {currentYear} Stefano Bichicchi - FullStack Web Developer. {t.footer.rights}
		</p>
		<div class="flex whitespace-nowrap" aria-hidden="true">
			<!-- First copy -->
			<div class="animate-marquee flex items-center gap-8 pl-8">
				{Array.from({ length: 4 }).map(() => (
					<span class="font-mono text-xs font-bold tracking-wider uppercase">
						© {currentYear} Stefano Bichicchi - FullStack Web Developer. {t.footer.rights}
					</span>
				))}
			</div>
			<!-- Second copy for seamless loop -->
			<div class="animate-marquee flex items-center gap-8 pl-8">
				{Array.from({ length: 4 }).map(() => (
					<span class="font-mono text-xs font-bold tracking-wider uppercase">
						© {currentYear} Stefano Bichicchi - FullStack Web Developer. {t.footer.rights}
					</span>
				))}
			</div>
		</div>
	</div>
</footer>
