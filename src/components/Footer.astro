---
import { translations, type Locale } from '../i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];

const homeHref = locale === 'it' ? '/' : '/en';
const personalHref = locale === 'it' ? '/personal' : '/en/personal';

const currentYear = new Date().getFullYear();

const socials = [
	{ name: 'GitHub', url: 'https://github.com/ehystiv', icon: 'gh' },
	{ name: 'LinkedIn', url: 'https://linkedin.com/in/stefanobichicchi', icon: 'li' }
];
---

<footer class="relative mt-auto border-t border-[var(--color-border)]">
	<div class="neon-rule absolute -top-px right-0 left-0"></div>
	<!-- Main footer content -->
	<div class="mx-auto max-w-7xl px-6 py-12">
		<div class="grid gap-8 md:grid-cols-3">
			<!-- Brand -->
			<div>
				<h3 class="mb-4 text-xl font-black tracking-widest">
					EHYSTIV<span class="neon-text">.DEV</span>
				</h3>
				<p class="text-sm leading-relaxed text-[var(--color-muted)]">{t.footer.description}</p>
			</div>

			<!-- Quick Links -->
			<div>
				<h4 class="hud-label mb-4 font-bold">{t.footer.quick_links}</h4>
				<ul class="space-y-2">
					<li>
						<a
							href={`${homeHref}#projects`}
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							→ {t.nav.projects}
						</a>
					</li>
					<li>
						<a
							href={`${homeHref}#about`}
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							→ {t.nav.about}
						</a>
					</li>
					<li>
						<a
							href={personalHref}
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							→ {t.nav.personal}
						</a>
					</li>
					<li>
						<a
							href="mailto:stefano@bichicchi.it"
							class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent-alt)]"
						>
							→ {t.about.cta_contact}
						</a>
					</li>
				</ul>
			</div>

			<!-- Social -->
			<div>
				<h4 class="hud-label mb-4 font-bold">{t.footer.social}</h4>
				<div class="flex gap-3">
					{socials.map((social) => (
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							class="btn-cyber flex h-12 w-12 items-center justify-center !p-0 font-mono text-xs font-bold uppercase no-underline"
							title={social.name}
						>
							{social.icon}
						</a>
					))}
				</div>
			</div>
		</div>
	</div>

	<!-- Copyright bar -->
	<div class="overflow-hidden bg-[var(--color-bar-bg)] py-2 text-[var(--color-bar-fg)]">
		<div class="flex whitespace-nowrap">
			<!-- First copy -->
			<div class="animate-marquee flex items-center gap-8 pl-8">
				{Array.from({ length: 4 }).map(() => (
					<span class="font-mono text-xs font-bold tracking-wider uppercase">
						© {currentYear} Stefano Bichicchi - FullStack Web Developer. {t.footer.rights}
					</span>
				))}
			</div>
			<!-- Second copy for seamless loop -->
			<div class="animate-marquee aria-hidden flex items-center gap-8 pl-8" aria-hidden="true">
				{Array.from({ length: 4 }).map(() => (
					<span class="font-mono text-xs font-bold tracking-wider uppercase">
						© {currentYear} Stefano Bichicchi - FullStack Web Developer. {t.footer.rights}
					</span>
				))}
			</div>
		</div>
	</div>
</footer>
