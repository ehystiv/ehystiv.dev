---
import profilePic from '../assets/profile_pic.png';
import InterestCard from '../components/InterestCard.astro';
import JokeMarquee from '../components/JokeMarquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpotlightProjectCard, {
	type SpotlightStats
} from '../components/SpotlightProjectCard.astro';
import gitSeaLogo from '../assets/projects/git-sea.svg';
import { projects } from '../data/projects';
import type { Interest } from '../data/interests';
import BaseLayout from '../layouts/BaseLayout.astro';
import { translations, type Locale } from '../i18n/translations';

interface GitHubRepo {
	name: string;
	description: string | null;
	html_url: string;
	topics: string[];
}

const locale = (Astro.currentLocale ?? 'it') as Locale;
const t = translations[locale];

const apiKey = import.meta.env.API_TOKEN as string | undefined;

// Fetch Joke
const jokePromise = (async (): Promise<string | null> => {
	if (!apiKey) {
		console.error('API_TOKEN not found in environment variables');
		return null;
	}
	try {
		const response = await fetch('https://api.api-ninjas.com/v1/jokeoftheday', {
			headers: { 'X-Api-Key': apiKey }
		});
		if (response.ok) {
			const data = await response.json();
			return data[0]?.joke ?? null;
		}
		console.error('Failed to fetch joke:', response.statusText);
		return null;
	} catch (error) {
		console.error('Error fetching joke:', error);
		return null;
	}
})();

// Fetch GitHub Stars (Interests)
const githubHeaders: Record<string, string> = {
	'User-Agent': 'ehystiv.dev',
	'X-GitHub-Api-Version': '2022-11-28'
};
const githubToken = import.meta.env.GITHUB_TOKEN as string | undefined;
if (githubToken) {
	githubHeaders['Authorization'] = `Bearer ${githubToken}`;
}

const interestsPromise = (async (): Promise<Interest[]> => {
	try {
		const response = await fetch(
			'https://api.github.com/users/ehystiv/starred?sort=created&direction=desc&per_page=100',
			{ headers: githubHeaders }
		);

		if (response.ok) {
			const data: GitHubRepo[] = await response.json();
			return data.map((repo) => ({
				name: repo.name,
				description: {
					en: repo.description || '',
					it: repo.description || ''
				},
				url: repo.html_url,
				tags: (repo.topics || []).slice(0, 5)
			}));
		}
		console.error('Failed to fetch GitHub stars:', response.statusText);
		return [];
	} catch (error) {
		console.error('Error fetching GitHub stars:', error);
		return [];
	}
})();

// Fetch latest release and stars of the spotlight project
const spotlightProject = projects.find((project) => project.spotlight);
const gridProjects = projects.filter((project) => !project.spotlight);

const spotlightPromise = (async (): Promise<SpotlightStats> => {
	const stats: SpotlightStats = { version: null, releaseUrl: null, stars: null };
	if (!spotlightProject?.spotlight) return stats;
	const api = `https://api.github.com/repos/${spotlightProject.spotlight.repo}`;
	try {
		const [repoRes, releaseRes] = await Promise.all([
			fetch(api, { headers: githubHeaders }),
			fetch(`${api}/releases/latest`, { headers: githubHeaders })
		]);
		if (repoRes.ok) {
			const repo: { stargazers_count: number } = await repoRes.json();
			stats.stars = repo.stargazers_count;
		} else {
			console.error('Failed to fetch spotlight repo:', repoRes.statusText);
		}
		if (releaseRes.ok) {
			const release: { tag_name: string; html_url: string } = await releaseRes.json();
			stats.version = release.tag_name;
			stats.releaseUrl = release.html_url;
		} else {
			console.error('Failed to fetch spotlight release:', releaseRes.statusText);
		}
	} catch (error) {
		console.error('Error fetching spotlight project:', error);
	}
	return stats;
})();

const [joke, interests, spotlightStats] = await Promise.all([
	jokePromise,
	interestsPromise,
	spotlightPromise
]);

const skills = [
	{ category: 'Backend', items: ['PHP', 'Laravel', 'NestJS', 'Node.js', 'Python'] },
	{ category: 'Frontend', items: ['Vue.js', 'Svelte', 'React', 'TypeScript', 'Tailwind'] },
	{ category: 'DevOps', items: ['Docker', 'Terraform', 'CI/CD', 'Linux'] },
	{ category: 'Database', items: ['MySQL', 'PostgreSQL', 'Redis', 'MongoDB'] },
	{ category: 'AI', items: ['Claude Code', 'Codex', 'OpenCode', 'Copilot'] }
];

const INITIAL_VISIBLE_INTERESTS = 8;
---

<BaseLayout locale={locale}>
	<!-- Hero Section -->
	<section class="relative overflow-hidden border-b border-[var(--color-border)]">
		<!-- Background: neon grid fading out + city glow -->
		<div class="hero-grid absolute inset-0" aria-hidden="true"></div>
		<div class="hero-glow absolute inset-0" aria-hidden="true"></div>

		<!-- Vertical neon sign -->
		<div
			class="neon-sign flicker absolute top-16 right-8 hidden font-bold select-none lg:block"
			aria-hidden="true"
		>
			デベロッパー
		</div>

		<div class="relative mx-auto max-w-7xl px-6 py-24 md:py-32">
			<div class="max-w-4xl">
				<!-- Greeting -->
				<p class="hud-label mb-6 flex items-center gap-3">
					<span
						class="inline-block h-2 w-2 bg-[var(--color-accent-hot)] shadow-[0_0_8px_var(--color-accent-hot)]"
						aria-hidden="true"
					></span>
					<span class="hud-prefix" data-scramble>
						{t.hero.greeting}
					</span>
				</p>

				<!-- Name and Profile Pic -->
				<div class="mb-4 flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10">
					<h1 class="text-5xl leading-none font-black md:text-7xl lg:text-8xl">
						<span class="glitch" data-text="STEFANO">
							STEFANO
						</span>
						<br />
						<span class="glitch neon-text" data-text="BICHICCHI">
							BICHICCHI
						</span>
					</h1>
					<div class="hud-corners h-28 w-28 shrink-0 md:h-36 md:w-36 lg:h-44 lg:w-44">
						<div class="profile-frame h-full w-full">
							<img
								src={profilePic.src}
								alt="Stefano Bichicchi"
								class="profile-img h-full w-full object-cover"
							/>
						</div>
					</div>
				</div>

				<div class="mb-8 ml-1 font-mono text-sm text-[var(--color-accent-hot)]">
					<span aria-hidden="true">&gt;</span> "{t.hero.citation}"
					<span class="cursor-blink" aria-hidden="true"></span>
				</div>

				<!-- Role -->
				<div class="mb-8 flex items-center gap-4">
					<div class="neon-rule w-16"></div>
					<p class="neon-text-alt font-mono text-lg font-bold tracking-[0.2em] uppercase md:text-xl">
						{t.hero.role}
					</p>
				</div>

				<!-- Description -->
				<p class="mb-10 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)] md:text-xl">
					{t.hero.description_pre}
					<span class="font-bold text-[var(--color-fg)]"> Laravel</span>,
					<span class="font-bold text-[var(--color-fg)]"> Vue.js</span>
					{t.hero.description_post}
				</p>

				<!-- CTAs -->
				<div class="flex flex-wrap gap-4">
					<a href="#projects" class="btn-cyber btn-cyber-filled no-underline">
						{t.hero.cta_projects} <span aria-hidden="true">→</span>
					</a>
					<a
						href="https://github.com/ehystiv"
						target="_blank"
						rel="noopener noreferrer"
						class="btn-cyber no-underline"
					>
						{t.hero.cta_github}
						<span class="sr-only">{t.a11y.new_tab}</span>
					</a>
				</div>
			</div>
		</div>

		<!-- HUD readout -->
		<div
			class="absolute right-6 bottom-4 hidden font-mono text-xs leading-relaxed tracking-widest text-[var(--color-muted)] uppercase md:block"
			aria-hidden="true"
		>
			<div>
				SYS.STATUS <span class="text-[var(--color-accent-alt)]">ONLINE</span>
			</div>
			<div>LOC 127.0.0.1 // LOCALHOST</div>
			<div>
				NET.LINK <span class="text-[var(--color-accent)]">SECURE</span>
			</div>
		</div>
	</section>

	<!-- Projects Section -->
	<section id="projects" class="scroll-mt-4 border-b border-[var(--color-border)]">
		<div class="mx-auto max-w-7xl px-6 py-20">
			<!-- Section header -->
			<div class="mb-12 flex items-end justify-between">
				<div>
					<p class="hud-label hud-prefix mb-2" data-scramble>
						{t.projects.pretitle}
					</p>
					<h2 class="text-4xl font-black md:text-5xl" data-scramble>
						{t.projects.title}
					</h2>
				</div>
				<div class="neon-rule mb-3 ml-8 hidden flex-1 md:block"></div>
			</div>

			{spotlightProject && (
				<SpotlightProjectCard
					project={spotlightProject}
					logo={gitSeaLogo}
					stats={spotlightStats}
					locale={locale}
				/>
			)}

			<!-- Projects grid -->
			<div class="grid gap-8 md:grid-cols-2">
				{gridProjects.map((project) => (
					<ProjectCard project={project} locale={locale} />
				))}
			</div>

			<!-- View more -->
			<div class="mt-12 text-center">
				<a
					href="https://github.com/ehystiv?tab=repositories"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-cyber inline-block no-underline"
				>
					{t.projects.view_all} <span aria-hidden="true">→</span>
					<span class="sr-only">{t.a11y.new_tab}</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Inspirations Section -->
	<section id="inspirations" class="scroll-mt-4 border-b border-[var(--color-border)]">
		<div class="mx-auto max-w-7xl px-6 py-20">
			<div class="mb-12">
				<p class="hud-label hud-prefix mb-2" data-scramble>
					{t.inspirations.pretitle}
				</p>
				<h2 class="text-4xl font-black md:text-5xl" data-scramble>
					{t.inspirations.title}
				</h2>
				<p class="mt-4 max-w-2xl text-[var(--color-muted)]">{t.inspirations.description}</p>
			</div>

			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{interests.map((interest, index) => (
					<InterestCard
						interest={interest}
						locale={locale}
						hidden={index >= INITIAL_VISIBLE_INTERESTS}
					/>
				))}
			</div>

			<!-- Show more button -->
			{interests.length > INITIAL_VISIBLE_INTERESTS && (
				<div id="show-more-wrapper" class="mt-8 text-center">
					<button id="show-more-interests" data-step={INITIAL_VISIBLE_INTERESTS} class="btn-cyber">
						{t.inspirations.show_more}
					</button>
				</div>
			)}
		</div>
	</section>

	{joke && <JokeMarquee joke={joke} locale={locale} />}

	<!-- About Section -->
	<section id="about" class="scroll-mt-4">
		<div class="mx-auto max-w-7xl px-6 py-20">
			<div class="grid gap-12 lg:grid-cols-2">
				<!-- About text -->
				<div>
					<p class="hud-label hud-prefix mb-2" data-scramble>
						{t.about.pretitle}
					</p>
					<h2 class="mb-8 text-4xl font-black md:text-5xl" data-scramble>
						{t.about.title}
					</h2>

					<div class="space-y-4 text-lg leading-relaxed text-[var(--color-muted)]">
						<p>
							{t.about.p1_pre}
							<strong class="text-[var(--color-fg)]"> Full Stack Developer </strong>
							{t.about.p1_post}
						</p>
						<p>
							{t.about.p2_pre}
							<strong class="text-[var(--color-fg)]"> PHP/Laravel </strong>
							{t.about.p2_mid}
							<strong class="text-[var(--color-fg)]"> Vue.js </strong>
							{t.about.p2_and}
							<strong class="text-[var(--color-fg)]"> Svelte</strong>.
						</p>
						<p>{t.about.p3}</p>
					</div>

					<!-- Contact CTA -->
					<div class="mt-8">
						<a href="mailto:ehystiv@gmail.com" class="btn-cyber btn-cyber-filled no-underline">
							{t.about.cta_contact}
						</a>
					</div>
				</div>

				<!-- Skills -->
				<div class="cyber-panel p-6">
					<div class="mb-6 flex items-center justify-between">
						<h3 class="text-xl font-bold">{t.about.tech_stack}</h3>
						<span
							class="font-mono text-xs tracking-widest text-[var(--color-muted)]"
							aria-hidden="true"
						>
							MODULES.LOADED
						</span>
					</div>

					<div class="space-y-6">
						{skills.map((skillGroup) => (
							<div>
								<h4 class="neon-text mb-3 font-mono text-sm font-bold tracking-wider uppercase">
									<span aria-hidden="true">&gt;</span> {skillGroup.category}
								</h4>
								<div class="flex flex-wrap gap-2">
									{skillGroup.items.map((skill) => (
										<span class="tag">{skill}</span>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero-grid {
		background-image:
			linear-gradient(var(--color-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: linear-gradient(to bottom, black 30%, transparent 100%);
	}

	.hero-glow {
		background:
			radial-gradient(ellipse 50% 60% at 85% 20%, rgb(255 42 109 / 0.18), transparent 70%),
			radial-gradient(ellipse 40% 50% at 70% 90%, rgb(0 240 255 / 0.12), transparent 70%);
	}

	:global(:root:not(.dark)) .hero-glow {
		display: none;
	}

	.neon-sign {
		writing-mode: vertical-rl;
		font-size: 4.5rem;
		letter-spacing: 0.15em;
		color: transparent;
		-webkit-text-stroke: 1.5px var(--color-accent-hot);
		filter: drop-shadow(0 0 8px var(--color-accent-hot));
		opacity: 0.55;
	}

	/* Profile picture in a cut-corner neon frame (the frame color shows as the "border") */
	.profile-frame {
		padding: 2px;
		background: linear-gradient(135deg, var(--color-accent-alt), var(--color-accent-hot));
		clip-path: polygon(
			0 0,
			calc(100% - 20px) 0,
			100% 20px,
			100% 100%,
			20px 100%,
			0 calc(100% - 20px)
		);
	}

	.profile-img {
		clip-path: polygon(
			0 0,
			calc(100% - 19px) 0,
			100% 19px,
			100% 100%,
			19px 100%,
			0 calc(100% - 19px)
		);
		filter: saturate(1.1) contrast(1.05);
	}
</style>

<script>
	// "Show more" for the interests grid: reveal the next batch on each click
	const showMoreButton = document.getElementById('show-more-interests');

	if (showMoreButton) {
		const step = Number(showMoreButton.dataset.step ?? 8);

		showMoreButton.addEventListener('click', () => {
			const hiddenCards = document.querySelectorAll('[data-interest][hidden]');
			hiddenCards.forEach((card, index) => {
				if (index < step) card.removeAttribute('hidden');
			});

			if (document.querySelectorAll('[data-interest][hidden]').length === 0) {
				document.getElementById('show-more-wrapper')?.remove();
			}
		});
	}
</script>
