---
import { translations, type Locale } from '../i18n/translations';

interface Props {
	joke: string;
	locale: Locale;
}

const { joke, locale } = Astro.props;
const t = translations[locale];
---

<div class="joke-bar flex overflow-hidden bg-[var(--color-accent-hot)] py-3 whitespace-nowrap">
	<p class="sr-only">
		{t.a11y.joke_of_the_day}: {joke}
	</p>
	<div class="animate-marquee-joke flex" aria-hidden="true">
		{Array.from({ length: 4 }).map(() => (
			<span class="px-4 font-mono text-lg font-bold text-[var(--color-ink)] uppercase">
				▲ INCOMING TRANSMISSION // JOKE OF THE DAY: {joke} ///
			</span>
		))}
	</div>
</div>

<style>
	.joke-bar {
		box-shadow: 0 0 24px rgb(255 42 109 / 0.45);
	}

	.animate-marquee-joke {
		animation: marquee-joke 30s linear infinite;
	}

	@keyframes marquee-joke {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
</style>
