---
import type { Interest } from '../data/interests';
import type { Locale } from '../i18n/translations';

interface Props {
	interest: Interest;
	locale: Locale;
	hidden?: boolean;
}

const { interest, locale, hidden = false } = Astro.props;
---

<a
	href={interest.url}
	target="_blank"
	rel="noopener noreferrer"
	data-interest
	hidden={hidden}
	class="group cyber-panel hover-neon block h-full p-6 no-underline"
>
	<div class="mb-2 flex items-center justify-between">
		<h3 class="glitch-hover font-mono text-base font-bold tracking-wider break-all uppercase transition-colors group-hover:text-[var(--color-accent)]">
			{interest.name}
		</h3>
		<span class="text-xl font-bold text-[var(--color-accent)] opacity-0 transition-opacity group-hover:opacity-100">
			↗
		</span>
	</div>

	<p class="mb-4 text-sm leading-relaxed text-[var(--color-muted)]">
		{interest.description[locale]}
	</p>

	<div class="flex flex-wrap gap-2">
		{interest.tags.map((tag) => (
			<span class="tag text-[10px]">{tag}</span>
		))}
	</div>
</a>
